# Contoh pengaturan backend. Salin file ini jadi ".env" (di folder yang sama),
# lalu sesuaikan dengan MySQL di laptop masing-masing.
# File .env TIDAK ikut ke GitHub, jadi password kamu aman.

PORT=3000
DB_HOST=localhost

# XAMPP standar: user root tanpa password (DB_PASS dikosongkan).
# Kalau MySQL kamu pakai user/password lain, isi di sini.
DB_USER=root
DB_PASS=
DB_NAME=network_adventure
